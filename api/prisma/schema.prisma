generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection, used by the running server.
  url       = env("DATABASE_URL")
  // Direct (unpooled) connection. Migrations and introspection need a real
  // session, which a transaction-mode pooler like Supabase's PgBouncer can't
  // give them. Set it to the same value as DATABASE_URL if you aren't pooling.
  directUrl = env("DIRECT_URL")
}

model Account {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())

  /// Last time this account made any authenticated request — opening the app
  /// counts, not just writing a log. Stamped by the auth middleware, throttled
  /// so a busy session is one write every few minutes rather than one per
  /// request. Null on every account that hasn't been seen since this column
  /// existed, which is why the admin dashboard treats it as one candidate for
  /// "last active" rather than the answer: the newest of it, the account's
  /// newest log, its newest timer and its newest push-token refresh is.
  lastSeenAt DateTime?

  /// This caregiver's own relationship to the babies they look after — asked
  /// once during onboarding, before any baby exists, and copied onto the owner
  /// membership of every baby they create. Null on accounts made before it was
  /// asked, which is what stops them being sent back through onboarding.
  relation     String?
  /// Free text for relation = "other". Ignored otherwise.
  relationNote String?

  // --- Settings ---
  unitSystem           String  @default("metric") // metric | imperial
  // Accent colour override for this caregiver's own app. Null means "derive
  // from the baby", which is the historical gender-based palette.
  themeColor           String?
  notificationsEnabled Boolean @default(true)

  ownedBabies    Baby[]          @relation("BabyOwner")
  memberships    BabyMember[]
  invitesSent    BabyInvite[]    @relation("InviteSender")
  profiles       Profile[]
  logs           ActivityLog[]
  activeTimers   ActiveTimer[]
  reminders      Reminder[]
  pushTokens     PushToken[]
  passwordResets PasswordReset[]

  @@index([lastSeenAt])
}

/// A single-use code emailed to reclaim a forgotten password. Same shape as a
/// BabyInvite link — a high-entropy random token, stored as issued rather than
/// hashed, because 24 random bytes is already computationally infeasible to
/// guess and this codebase already trusts that reasoning for invite links.
model PasswordReset {
  id        Int      @id @default(autoincrement())
  accountId Int
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model Baby {
  id                      Int       @id @default(autoincrement())
  // The account that created the baby. Kept on the original `accountId` column
  // so adding sharing needed no destructive rename. It confers no read access
  // on its own — every caregiver, owner included, has a BabyMember row.
  ownerAccountId          Int       @map("accountId")
  name                    String
  dob                     DateTime?
  gender                  String // "girl" | "boy"
  avatarEmoji             String?
  avatarColor             String?
  createdAt               DateTime  @default(now())
  /// The milk balance (pumped minus bottled) is otherwise entirely computed
  /// from ActivityLog — this is a hand correction added on top, in ml. Stored
  /// as an offset rather than an absolute value so pump/bottle logs keep
  /// adjusting the total from wherever a caregiver last corrected it to,
  /// instead of a manual edit being silently overwritten by the next log.
  milkBalanceAdjustmentMl Float     @default(0)
  /// How many nappies are on hand, unlike the milk balance above not derived
  /// from anything — there's no log type a "diaper bought" event belongs to,
  /// so this is the number itself, moved directly by a restock or a use
  /// rather than computed from history each time it's read.
  diaperStockCount        Int       @default(0)

  owner        Account       @relation("BabyOwner", fields: [ownerAccountId], references: [id], onDelete: Cascade)
  members      BabyMember[]
  invites      BabyInvite[]
  reminders    Reminder[]
  logs         ActivityLog[]
  activeTimers ActiveTimer[]
  vaccines     Vaccine[]
  bagItems     BagItem[]
}

/// Who may read and write a baby's logs. This is the only source of truth for
/// access; every query about a baby goes through it.
model BabyMember {
  id           Int      @id @default(autoincrement())
  babyId       Int
  accountId    Int
  role         String   @default("member") // owner | member
  /// How this person is related to the baby — mother, father, sister… Purely
  /// descriptive: it never affects access, which `role` alone decides. Null on
  /// everyone who joined before it was asked for.
  relation     String?
  /// Free text for relation = "other", e.g. "Nanny". Ignored otherwise.
  relationNote String?
  createdAt    DateTime @default(now())

  baby    Baby    @relation(fields: [babyId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([babyId, accountId])
  @@index([accountId])
}

/// A caregiver who has been invited but isn't a member yet.
///
/// Two flavours share this table:
///   - email invite — `email` set, `token` null. Claimed automatically when that
///     exact address signs up or signs in.
///   - link invite  — `token` set, `email` null. Claimed by whoever opens the
///     link while signed in, whatever address they used. This is why `email` is
///     nullable: a link has no addressee until someone accepts it.
model BabyInvite {
  id                 Int       @id @default(autoincrement())
  babyId             Int
  email              String?
  /// Unguessable claim code for a link invite. Null on email invites.
  token              String?   @unique
  role               String    @default("member")
  relation           String?
  relationNote       String?
  /// Link invites expire so a forwarded message can't grant access forever.
  /// Null on email invites, which are addressed and so can wait indefinitely.
  expiresAt          DateTime?
  invitedByAccountId Int
  createdAt          DateTime  @default(now())

  baby      Baby    @relation(fields: [babyId], references: [id], onDelete: Cascade)
  invitedBy Account @relation("InviteSender", fields: [invitedByAccountId], references: [id], onDelete: Cascade)

  // Postgres allows many NULLs in a unique index, so link invites (email null)
  // don't collide with each other while email invites stay one-per-address.
  @@unique([babyId, email])
  @@index([email])
}

/// One month of the immunisation schedule for a baby, months 1–12.
///
/// A row exists only once the month has been touched — the schedule itself is
/// fixed and lives in the client, so an untouched month needs no storage. Taken
/// is `givenAt != null` rather than a separate flag, because a dose that was
/// given always has a date and one that wasn't never does.
model Vaccine {
  id          Int       @id @default(autoincrement())
  babyId      Int
  /// Age in months, 1–12. Odd months are mandatory, even months optional.
  monthNumber Int
  givenAt     DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  baby Baby @relation(fields: [babyId], references: [id], onDelete: Cascade)

  @@unique([babyId, monthNumber])
  @@index([babyId])
}

/// One line on the "what's in the bag" checklist — nappies, wipes, a spare
/// outfit. Shared across every caregiver of the baby, same as everything else
/// here: whoever packs sees what another caregiver already checked off.
model BagItem {
  id        Int      @id @default(autoincrement())
  babyId    Int
  label     String
  checked   Boolean  @default(false)
  /// Manual sort position, lowest first. New items get one past the current
  /// highest for their baby, so they append at the end by default; existing
  /// items only move when a caregiver reorders them.
  order     Int      @default(0)
  createdAt DateTime @default(now())

  baby Baby @relation(fields: [babyId], references: [id], onDelete: Cascade)

  @@index([babyId])
}

/// "Remind me to give vitamins at 9am on weekdays." Owned by one caregiver so
/// each can mute independently, but attached to a shared baby.
model Reminder {
  id              Int       @id @default(autoincrement())
  babyId          Int
  accountId       Int
  type            String // feed|pump|sleep|diaper|shower|vitamin|nailcut|custom
  label           String? // shown instead of the type's name, required for custom
  /// Deprecated. Reminders fire at a time of day now (see `timeOfDay`); nothing
  /// reads this. Kept nullable rather than dropped so existing rows survive, and
  /// so the old value is still there if a schedule ever needs explaining.
  intervalMinutes Int?
  /// Minutes after local midnight, 0–1439 — 540 is 9:00am. The caregiver's
  /// midnight, not the server's: see tzOffsetMinutes. Existing rows default to
  /// 9am, which is what an interval reminder becomes when it is converted.
  timeOfDay       Int       @default(540)
  /// Which days this may fire on, as sorted comma-separated weekday numbers
  /// (0 = Sunday … 6 = Saturday) — "1,2,3,4,5" for weekdays only. Null means
  /// every day, which is what every reminder created before this existed is.
  /// Mutually exclusive with `everyDays` — set together, never both active.
  daysOfWeek      String?
  /// The other schedule mode: fire every N days instead of on chosen
  /// weekdays — a nail cut every 10 days, say, rather than always Tuesdays.
  /// Counted from whenever this last actually fired (lastNotifiedAt), or
  /// from `createdAt` if it never has — see isDueByInterval. Null means this
  /// reminder uses `daysOfWeek` instead.
  everyDays       Int?
  /// The device's UTC offset in minutes when the reminder was set, so both
  /// "Tuesday" and "9am" mean the caregiver's rather than the server's. Null
  /// falls back to UTC. Stored rather than derived because the server has no
  /// other way to know where the account is. Now always recorded, not just when
  /// days are restricted — a time of day is meaningless without it.
  tzOffsetMinutes Int?
  enabled         Boolean   @default(true)
  lastNotifiedAt  DateTime?
  createdAt       DateTime  @default(now())

  baby    Baby    @relation(fields: [babyId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([babyId, accountId])
  @@index([enabled])
}

model PushToken {
  id        Int      @id @default(autoincrement())
  accountId Int
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model Profile {
  id          Int           @id @default(autoincrement())
  accountId   Int
  displayName String
  createdAt   DateTime      @default(now())
  account     Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  logs        ActivityLog[]
}

model ActivityLog {
  id                  Int       @id @default(autoincrement())
  // The account that wrote this entry. Authorship only — access is decided by
  // BabyMember, so any caregiver of the baby can edit or delete it. Nullable
  // because a caregiver who deletes their account leaves the baby's history
  // behind: SetNull orphans the entry instead of taking it with them, unlike
  // Baby's own cascade, which does delete every log when an owner's account
  // goes.
  accountId           Int?
  babyId              Int
  profileId           Int?
  type                String // feed|pump|sleep|diaper|shower|vitamin|nailcut|growth|health
  side                String? // left|right
  /// Minutes spent on each breast, when a feed or pump switched sides mid
  /// session. Both null on one that stayed on a single side (`side` alone
  /// says everything there) and on every entry predating per-side timing —
  /// so a reader must treat "no split" as unknown, never as zero.
  leftMinutes         Float?
  rightMinutes        Float?
  amountMl            Float? // bottle feed / pump volume
  diaperStatus        String? // empty|wet|dirty|wet_and_dirty
  weightKg            Float?
  heightCm            Float?
  headCircumferenceCm Float?
  /// "nap" | "night", on a sleep entry. Null on everything else, and on sleeps
  /// recorded before the distinction existed — which is why nothing derives it
  /// from the clock as a fallback: a 7pm start is a nap in one household and
  /// bedtime in the next, and guessing would put invented data in the averages.
  sleepKind           String?
  healthCondition     String? // fever|cold|stomach|other
  medication          String?
  dose                String?
  feverCelsius        Float?
  startTime           DateTime
  endTime             DateTime?
  durationMinutes     Float?
  comments            String?
  enteredByName       String
  // JSON array of { event: started|paused|resumed|stopped, at: ISO } for timed
  // activities that were paused at least once.
  pauseTimelineJson   String?   @db.Text
  createdAt           DateTime  @default(now())

  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  baby    Baby     @relation(fields: [babyId], references: [id], onDelete: Cascade)
  profile Profile? @relation(fields: [profileId], references: [id])

  @@index([babyId, startTime])
}

/// The lock that stops a second caregiver starting the same timed activity
/// while one is already running. One row per (baby, type) while a feed, pump
/// or sleep is in progress — created the moment a timer starts, removed the
/// moment it's finished or discarded. Not history: the ActivityLog row it
/// becomes is only written once the session is actually saved, same as
/// before this existed.
model ActiveTimer {
  id            Int      @id @default(autoincrement())
  babyId        Int
  type          String // feed | pump | sleep
  // Whoever's device claimed the lock. Nullable for the same reason as
  // ActivityLog.accountId — an account can be deleted without erasing the
  // lock (though in practice it's cleared within minutes either way).
  accountId     Int?
  enteredByName String
  /// True start of the activity, unaffected by pauses — same meaning as
  /// ActivityLog.startTime once this becomes one.
  startTime     DateTime
  side          String? // left | right, for feed/pump
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  baby    Baby     @relation(fields: [babyId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  // One running timer per activity per baby — a second caregiver's attempt to
  // start the same type collides with this instead of creating a duplicate.
  @@unique([babyId, type])
}

/// Whoever runs the admin dashboard.
///
/// Deliberately not a flag on Account. An admin is not a caregiver: they have
/// no baby, and if they shared the caregiver table they would quietly show up
/// in every number the dashboard exists to report — one more "user", one more
/// dormant account. Keeping them apart also means an admin credential is
/// useless in the mobile app, and a caregiver session is useless here, without
/// either side having to remember to check a role.
model AdminUser {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  password    String
  name        String
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?
}
