# Copy to .env and fill in. .env is gitignored.

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# DATABASE_URL is what the running server uses.
# DIRECT_URL is used by `prisma migrate` / `prisma db push` only.
#
# Supabase — note the two different ports. The pooler (6543) is transaction
# mode, which cannot run migrations, so both are required and they are NOT
# interchangeable:
#
#   DATABASE_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
#   DIRECT_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres"
#
# Neon:
#   DATABASE_URL="postgresql://user:pw@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require"
#   DIRECT_URL="postgresql://user:pw@ep-xxx.region.aws.neon.tech/db?sslmode=require"
#
# Local Postgres (no pooler — just point both at the same place):
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/babytracker"
#   DIRECT_URL="postgresql://postgres:postgres@localhost:5432/babytracker"

DATABASE_URL=""
DIRECT_URL=""

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Signs the 30-day session tokens. Changing it signs everybody out.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# ---------------------------------------------------------------------------
# Reminders
# ---------------------------------------------------------------------------
# inline = in-process loop; only fires while the process is awake.
#          Right for local dev and always-on hosts.
# cron   = nothing runs in-process; an external scheduler POSTs to
#          /internal/reminders/tick. Required on free tiers that sleep.
REMINDER_MODE="inline"

# Shared secret guarding that endpoint. Required when REMINDER_MODE=cron.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Email (forgot-password)
# ---------------------------------------------------------------------------
# Plain SMTP, not a specific provider's API — sign-in is this app's own
# Account table and JWTs, not Supabase Auth, so there is no Supabase email
# feature to enable instead. Point these at whatever sends mail: Gmail's SMTP
# for a quick test, or a transactional sender for production (Resend,
# Postmark, SendGrid all offer an SMTP endpoint; so does Supabase itself, if
# the project has that enabled).
#
# Gmail (needs a 16-character App Password, not the account password —
# Google Account -> Security -> 2-Step Verification -> App passwords):
#   SMTP_HOST="smtp.gmail.com"
#   SMTP_PORT=587
#   SMTP_USER="you@gmail.com"
#   SMTP_PASS="<app password>"
#
# Without these four set, /auth/forgot-password 500s for a real account (and
# still 200s with the same generic message for one that doesn't exist —
# nothing here changes what a caller can tell about which emails are
# registered).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Defaults to SMTP_USER if unset. Override when the sending mailbox
# shouldn't be the visible "from" address.
SMTP_FROM=""

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3001
