{
  "expo": {
    "name": "Baby Tracker",
    "slug": "baby-tracker-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#fff5f7"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.babytracker.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fff5f7"
      },
      "package": "com.babytracker.mobile"
    },
    "plugins": [
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "d3feec35-c8d0-42c4-add6-fea9c7958c87"
      }
    },
    "owner": "aliwaelezz"
  }
}
